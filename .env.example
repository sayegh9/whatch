TMDB_API_TOKEN=
OMDB_API_KEY=

# Optional Gemini reasoning. Use a paid billing-enabled Gemini API project for
# private data handling. Both the global switch and per-request UI consent are required.
GEMINI_API_KEY=
WHATCH_GEMINI_ENABLED=false
WHATCH_GEMINI_MODEL=gemini-3.6-flash

# Optional overrides
# WHATCH_DATABASE_URL=sqlite:////absolute/path/to/whatch.db
# WHATCH_CATALOG_SOURCE=/absolute/path/to/catalog.md
# WHATCH_METADATA_LANGUAGE=en-US
